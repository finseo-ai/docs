{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Finseo",
  "colors": {
    "primary": "#0eca7b",
    "light": "#0eca7b",
    "dark": "#0a9956"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://finseo.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "finseo.ai",
        "href": "https://finseo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Dashboard",
      "href": "https://app.finseo.ai"
    }
  },
  "fonts": {
    "body": {
      "family": "Geist"
    },
    "heading": {
      "family": "Season Sans",
      "source": "/fonts/SeasonSansUprightsVF.woff2",
      "format": "woff2",
      "weight": 600
    }
  },
  "background": {
    "color": {
      "light": "#FAF9F5",
      "dark": "#1C1C1C"
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "css": [
    "/style.css"
  ],
  "api": {
    "mdx": {
      "server": "https://api.finseo.ai",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    }
  },
  "footer": {
    "socials": {
      "website": "https://finseo.ai",
      "linkedin": "https://linkedin.com/company/finseo"
    }
  },
